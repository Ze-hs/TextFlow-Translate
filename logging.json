{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "simple": {
      "format": "%(levelname)s: %(message)s"
    },
    "detailed": {
      "format": "%(asctime)s | %(levelname)-8s | %(filename)s:%(lineno)d | %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S%z"
    },
    "simple_colored": {
      "()": "colorlog.ColoredFormatter",
      "format": "%(log_color)s%(levelname)s%(reset)s: %(message)s"
    },
    "detailed_colored": {
      "()": "colorlog.ColoredFormatter",
      "format": "%(log_color)s%(asctime)s | %(levelname)-8s | %(filename)s:%(lineno)d | %(message)s%(reset)s",
      "datefmt": "%Y-%m-%d %H:%M:%S",
      "log_colors": {
        "DEBUG": "white",
        "INFO": "blue",
        "WARNING": "light_yellow",
        "ERROR": "red",
        "CRITICAL": "red,bg_white"
      }
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "level": "DEBUG",
      "formatter": "detailed_colored",
      "stream": "ext://sys.stderr"
    },
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "detailed",
      "filename": "debug/logs/nikke-assistant.log",
      "maxBytes": 1048576,
      "backupCount": 3,
      "encoding": "utf-8"
    }
  },

  "root": {
      "level": "DEBUG",
      "handlers": [
        "stderr",
        "file"
      ]
  }
}